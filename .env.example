# ACO System — Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# GitHub Integration
# =============================================================================
GITHUB_TOKEN=ghp_your_token_here
GITHUB_OWNER=your-github-org-or-username
GITHUB_REPO=your-repository-name

# =============================================================================
# LLM Provider (choose one section based on your provider)
# =============================================================================

# --- OpenAI ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your_key_here

# --- Anthropic ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your_key_here

# --- xAI ---
# LLM_PROVIDER=xai
# XAI_API_KEY=your_xai_key_here

# --- OpenRouter ---
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-your_key_here
# OPENROUTER_MODEL=anthropic/claude-sonnet-4-20250514

# =============================================================================
# Database
# =============================================================================
# SQLite (default for local development)
DATABASE_URL=sqlite:///./data/aco.db

# PostgreSQL (recommended for production/multi-instance)
# DATABASE_URL=postgresql://user:pass@localhost:5432/aco

# =============================================================================
# Redis (optional — for distributed task queue)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# Agent Settings
# =============================================================================
AGENT_POLL_INTERVAL_SECONDS=30
MAX_RETRY_ATTEMPTS=3

# =============================================================================
# Per-Agent Model Override (optional)
# Tip: Opus for complex reasoning, Sonnet for implementation, Haiku for lightweight tasks
# Set to "none" to disable LLM for that agent
# =============================================================================
# ACO-PM_MODEL=anthropic/claude-haiku-4-20250514
# ACO-ARCHITECT_MODEL=anthropic/claude-opus-4-20250514
# ACO-DEV_MODEL=anthropic/claude-sonnet-4-20250514
# ACO-PLANNER_MODEL=anthropic/claude-opus-4-20250514
# ACO-QA_MODEL=anthropic/claude-sonnet-4-20250514
# ACO-HUMAN=none

# =============================================================================
# Human Contact (for agent escalations — set to "none" to disable)
# =============================================================================
HUMAN_CONTACT_METHOD=whatsapp
HUMAN_PHONE=+1234567890
